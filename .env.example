# Copy to .env and fill in real values locally. NEVER commit a real .env.
# All of these are read by src/main/resources/application.yml.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/cleanarch
DB_USERNAME=cleanarch
DB_PASSWORD=change-me-local-only

# --- JWT signing (HS256) ---
# Generate a random 32+ byte secret, e.g.:
#   openssl rand -base64 48
# This placeholder is NOT a real secret and MUST be replaced.
APP_JWT_SECRET=REPLACE_WITH_A_32_BYTE_RANDOM_SECRET_0000
APP_JWT_TTL_SECONDS=3600

# --- Rate limit (generic fixed-window interceptor) ---
APP_RATELIMIT_MAX_REQUESTS=120
APP_RATELIMIT_WINDOW_SECONDS=60
